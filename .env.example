# Supabase (set these in Vercel → Project → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://tqpsvhtnoqhrvkntzlvz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Gf-8az1tn9zeJars_CxTOA_ghx-G5X3

# App URL used for Stripe redirect/return links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.gradpilotai.com

# --- Server-only secrets: set in Vercel, never commit real values ---
# Supabase service role (Project Settings → API). Used by the Stripe webhook and billing.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe secret key — TEST mode (sk_test_... / rk_test_...). Live keys are refused
# unless STRIPE_ALLOW_LIVE_MODE=true.
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Only if `npm run stripe:setup` printed "customer portal config created: bpc_..."
STRIPE_PORTAL_CONFIGURATION=
# Leave unset. "true" allows live payments.
STRIPE_ALLOW_LIVE_MODE=
# Optional: "true" once Stripe Tax is set up
STRIPE_AUTOMATIC_TAX=

# --- Adzuna jobs (server-only; never prefix with NEXT_PUBLIC_) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# "true" turns on the sync and hides the unverified sample jobs. Leave unset in Production
# until Adzuna has confirmed commercial-use permission.
ADZUNA_ENABLED=
# Optional comma-separated search terms (defaults in lib/jobs-sync.ts)
ADZUNA_QUERIES=
# Random secret for /api/cron/sync-jobs (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
